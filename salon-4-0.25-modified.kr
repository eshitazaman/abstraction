plts:
    formula launch   = (s=0)
                     & (c=0)
                     & (v1=0)
                     & (v2=0)
                     & (v3=0)
                     & (v4=0);

    formula complete = (c>=2);

    module plts
        s  : [0..4];
        c  : [0..4];
        v1 : [0..1];
        v2 : [0..1];
        v3 : [0..1];
        v4 : [0..1];

        // Modified: Only one branch per action (deterministic c increment when variable is new)
        // This ensures that reading a word always leads to the same c value
        [one] (s=0) -> 1.0:(s'=1)&(c'=min(4,c+(1-v1)))&(v1'=1);
        [two] (s=0) -> 1.0:(s'=2)&(c'=min(4,c+(1-v2)))&(v2'=1);
        [two] (s=1) -> 1.0:(s'=2)&(c'=min(4,c+(1-v2)))&(v2'=1);
        [three] (s=1) -> 1.0:(s'=3)&(c'=min(4,c+(1-v3)))&(v3'=1);
        [one] (s=2) -> 1.0:(s'=1)&(c'=min(4,c+(1-v1)))&(v1'=1);
        [four] (s=2) -> 1.0:(s'=4)&(c'=min(4,c+(1-v4)))&(v4'=1);
        [one] (s=3) -> 1.0:(s'=1)&(c'=min(4,c+(1-v1)))&(v1'=1);
        [four] (s=3) -> 1.0:(s'=4)&(c'=min(4,c+(1-v4)))&(v4'=1);
        [two] (s=4) -> 1.0:(s'=2)&(c'=min(4,c+(1-v2)))&(v2'=1);
        [three] (s=4) -> 1.0:(s'=3)&(c'=min(4,c+(1-v3)))&(v3'=1);
    endmodule
endplts

perception :
    (one.three.four.two)*+(two.four.three.one)*
endperception

property : Kh(launch,complete) >= 0.25
endproperty
